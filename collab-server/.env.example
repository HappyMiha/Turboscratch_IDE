# Copy this file to ".env" (in this collab-server folder) and fill it in.
# The .env file is never uploaded to GitHub.

# Ada, the AI coding helper: an API key from https://platform.claude.com
# (usage is paid per message). Leave empty to turn Ada off.
ANTHROPIC_API_KEY=

# Optional: which Claude model Ada uses (default claude-opus-5-5).
# claude-haiku-5-5 is much cheaper.
# TSC_AI_MODEL=claude-opus-5-5

# Optional limits (see README). "AI tokens": answers count 5x.
# On Claude Opus 5.5, 1,000,000 AI tokens cost about $4.
# AI_TOKENS_PER_DAY=5000000
# AI_TOKENS_PER_USER_PER_DAY=1000000
# AI_TOKENS_PER_IP_PER_DAY=2000000
# AI_TURNS_PER_DAY=150
# AI_MAX_CONCURRENT=8
